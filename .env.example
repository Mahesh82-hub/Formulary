POSTGRES_DB=formulary
POSTGRES_USER=formulary
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

# FastAPI
APP_ENV=development
APP_DEBUG=false
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]

# Hosted LLM generation (configure either or both)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq's built-in browser_search for GPT-OSS models. Offered only after an official source
# has been consulted in a turn; answers that use it carry a Web sources list.
GROQ_WEB_SEARCH_ENABLED=true
GROQ_WEB_SEARCH_MODELS=["openai/gpt-oss-120b","openai/gpt-oss-20b"]
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_TRANSIENT_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.25
# Per user turn. When either budget is reached, the model must synthesize a response
# from collected evidence and let the user decide whether to continue in the next turn.
CHAT_MAX_TOOL_ROUNDS=8
CHAT_MAX_TOOL_CALLS=12
# Local/staging troubleshooting only. APP_ENV=production always suppresses detailed chat errors.
CHAT_EXPOSE_ERROR_DETAILS=false

# openFDA (a free API key raises the daily request allowance)
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_SECONDS=30
OPENFDA_TOOL_MAX_RECORDS=25

# Upstream pacing and retries. openFDA allows about 240 requests/minute (4/s); staying under
# that keeps concurrent tool calls from tripping the limit. Retries use exponential backoff
# with full jitter and honour a Retry-After header when the response supplies one.
OPENFDA_RATE_LIMIT_PER_SECOND=3.0
OPENFDA_RATE_LIMIT_BURST=6
OPENFDA_MAX_ATTEMPTS=3
OPENFDA_RETRY_BASE_DELAY_SECONDS=0.5
OPENFDA_RETRY_MAX_DELAY_SECONDS=8.0

# Per-tool payload caps. Lower these for short-context models; raise them for long-context
# models. OPENFDA_RESULT_MAX_CHARACTERS bounds a single tool result before it is compacted
# into previews.
OPENFDA_QUERY_MAX_RECORDS=10
OPENFDA_LABEL_MAX_RECORDS=5
OPENFDA_SEARCH_MAX_RECORDS=10
OPENFDA_CRL_MAX_RECORDS=5
OPENFDA_INGEST_MAX_RECORDS=25
OPENFDA_RESULT_MAX_CHARACTERS=48000
FAERS_MAX_REACTIONS=25

# PubMed via NCBI E-utilities. An API key raises the limit from 3 to 10 requests/second.
# NCBI asks callers to identify themselves with a contact email.
PUBMED_API_KEY=
PUBMED_CONTACT_EMAIL=
PUBMED_ENABLED=true

# Drug-name resolution through RxNorm (NLM): international names such as paracetamol are also
# searched under their US adopted names. Results are cached; RxNav allows 20 requests/second.
RXNORM_ENABLED=true

# ClinicalTrials.gov v2. The registry asks callers to stay near 50 requests/minute.
CLINICALTRIALS_ENABLED=true
CLINICALTRIALS_RATE_LIMIT_PER_SECOND=0.8

# Regulatory intelligence. When enabled, the API process polls FDA and ClinicalTrials.gov on
# this interval, records what changed, and sends email/Slack digests to matching watches.
# Sources refresh daily to weekly, so polling more often than every few hours only spends
# rate budget. Leave disabled to run cycles with `python -m scripts.run_monitor` from cron.
INTELLIGENCE_MONITOR_ENABLED=false
INTELLIGENCE_POLL_INTERVAL_MINUTES=360
INTELLIGENCE_INITIAL_LOOKBACK_DAYS=7
INTELLIGENCE_NOTIFICATION_HORIZON_DAYS=14
INTELLIGENCE_DIGEST_MAX_EVENTS=25
# Used for links back to the app inside email and Slack digests.
APP_PUBLIC_URL=http://localhost:3000

# Federated search. Every question is asked of every registered source concurrently, so total
# latency tracks the per-source deadline rather than the number of sources. A source that
# misses its deadline is excluded and named in the answer rather than blocking it.
FEDERATED_PER_SOURCE_TIMEOUT_SECONDS=8.0
FEDERATED_PER_SOURCE_LIMIT=5
FEDERATED_MAX_RECORDS=12

# Reciprocal rank fusion, used for both hybrid retrieval and cross-source merging.
# Raise RETRIEVAL_RRF_K to flatten the influence of any single list's top hits.
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# Email OTP authentication
AUTH_OTP_PEPPER=replace_with_a_long_random_secret
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUESTS_PER_15_MINUTES=5
AUTH_OTP_REQUESTS_PER_IP_15_MINUTES=20
AUTH_SESSION_TTL_DAYS=30
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_START_TLS=true

# Local file storage and local BGE embeddings.
STORAGE_ROOT=storage
INGESTION_CHUNK_SIZE_TOKENS=1024
INGESTION_CHUNK_OVERLAP_TOKENS=128
INGESTION_SEARCH_MAX_CHUNKS=8
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_SEGMENT_TOKENS=384
EMBEDDING_SEGMENT_OVERLAP_TOKENS=48
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_CACHE_DIR=storage/models

# Optional: evaluation in LangSmith (apps/api/scripts/eval_langsmith.py). Create a key at
# https://smith.langchain.com under Settings -> API Keys. LANGSMITH_TRACING stays off so the
# app itself sends nothing; the eval script traces its own runs.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
